# Not a secret. Beta Pro ends at midnight Nov 16, Manila time (decision log, 2026-10-30).
BETA_PRO_UNTIL=2026-11-16T00:00:00+08:00
# Guardian email. Resend Free allows 100 a day across this and the website, so the
# app keeps under half of it.
GUARDIAN_MAIL_FROM=Pantas <noreply@pantas.study>
GUARDIAN_LINK_ORIGIN=https://app.pantas.study
GUARDIAN_DAILY_SEND_CAP=20
# Sign-in code email, per Manila day, in two buckets. Open is for strangers. Reserved is for
# selected beta testers and existing accounts. Open + reserved + guardian stays at or under
# the 100 a day that Resend Free allows across this, guardian email and the website.
SIGN_IN_DAILY_SEND_CAP=20
SIGN_IN_DAILY_RESERVED_CAP=40
# Keep Home callables warm during the beta. Set false to stop the pings.
WARMUP_ENABLED=true
# Not a secret. The OAuth client id of the Firebase Google provider. Google sign-in for an
# address that already has an account checks the Google ID token against it. Staging and dev
# leave it empty, so that path refuses there.
GOOGLE_WEB_CLIENT_ID=416041343210-48rd2t4jivmdt7s1jbkoleobuadq9olj.apps.googleusercontent.com
