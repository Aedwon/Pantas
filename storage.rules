rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /exports/{uid}/{fileName} {
      allow read, write: if false;
    }

    // Wrapped card images. Any signed-in user (incl. anonymous) uploads their
    // own; public reads are served through the renderWrappedPage function,
    // never the bucket. App Check gates genuine app installs.
    match /wrapped/{uid}/{fileName} {
      allow read: if false;
      allow create, update: if request.auth != null
          && request.auth.uid == uid
          && fileName.matches('^[0-9a-f]{32}[.]png$')
          && request.resource.contentType == 'image/png'
          && request.resource.size > 0
          && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if request.auth != null
          && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
