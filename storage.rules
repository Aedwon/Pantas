rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /exports/{uid}/{fileName} {
      allow read, write: if false;
    }

    // Wrapped card images. Owners (named users) upload their own; public reads
    // are served through the renderWrappedPage function, never the bucket.
    match /wrapped/{uid}/{fileName} {
      allow read: if false;
      allow write: if request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
