rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Storage permits two distinct Firestore documents per evaluation.
    // exists/get of the same consent path share the cached document lookup.
    // The same path holds pending tasks and permanent UID-only closure tombstones.
    function accountActive(uid) {
      let consent = /databases/(default)/documents/users/$(uid)/server/guardianConsent;
      return !firestore.exists(/databases/(default)/documents/accountDeletions/$(uid))
          && (!firestore.exists(consent)
              || firestore.get(consent).data.get('status', '') != 'withdrawn');
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && accountActive(uid);
    }

    match /betaFeedback/{uid}/{feedbackId}/{index} {
      allow read: if isOwner(uid);
      allow create: if resource == null
          && isOwner(uid)
          && feedbackId.matches('^[A-Za-z0-9]{20,32}$')
          && index.matches('^[012]$')
          && request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType.matches('^image/(png|jpeg|webp)$')
          // Anonymous owners may attach screenshots (the app lets a not-yet-signed-in
          // user send feedback). Custom metadata is refused so no download token can
          // be planted. No extra Firestore read: accountActive already uses both.
          && (request.resource.metadata == null || request.resource.metadata.size() == 0);
      allow update, delete: if false;
    }

    match /exports/{uid}/{fileName} {
      allow read, write: if false;
    }

    // Wrapped card images. Only a named (non-anonymous) owner uploads their own,
    // with no custom metadata (no download tokens). Public reads are served through
    // the renderWrappedPage function, never the bucket.
    match /wrapped/{uid}/{fileName} {
      allow read: if false;
      allow create, update: if isOwner(uid)
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && (request.resource.metadata == null || request.resource.metadata.size() == 0)
          && fileName.matches('^[0-9a-f]{32}[.]png$')
          && request.resource.contentType == 'image/png'
          && request.resource.size > 0
          && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
