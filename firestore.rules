rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isNamedUser() {
      return isSignedIn()
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return isNamedUser() && request.auth.uid == uid;
    }

    function isProUser() {
      return isNamedUser() && request.auth.token.pro == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'photoUrl',
            'lastSeenAt',
            'preferences',
            'schemaVersion'
          ]);
      allow delete: if false;

      match /lesson_progress/{lessonId} {
        allow read, write: if isOwner(uid);
      }

      match /quiz_attempts/{attemptId} {
        allow read, write: if isOwner(uid);
      }

      match /fsrs_cards/{cardId} {
        allow read, write: if isOwner(uid);
      }

      match /assessments/{assessmentId} {
        allow read, write: if isOwner(uid);
      }

      match /study_plan/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /mock_exam_attempts/{attemptId} {
        allow read, write: if isOwner(uid);
      }

      match /proDossiers/{dossierId} {
        allow read: if isOwner(uid) && request.auth.token.pro == true;
        allow write: if false;
      }
    }

    match /examTracks/{trackId}/proContent/{contentId} {
      allow read: if isProUser();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    // Hosted Wrapped cards. The landing-page Cloud Function reads these via
    // the Admin SDK (bypassing rules), so client reads stay closed. Sharing is
    // disclosed-not-gated (spec §5.1) and App Check is the real upload gate, so
    // any signed-in user (incl. anonymous) may create their own card and may
    // only flip `revoked` to true.
    match /wrapped_shares/{shareId} {
      allow read: if false;
      allow create: if isSignedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.revoked == false;
      allow update: if isSignedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['revoked'])
          && request.resource.data.revoked == true;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
