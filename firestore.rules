rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Two distinct documents, cached across ownership checks and batch writes.
    // Missing/trimmed consent is valid; any durable deletion task closes access.
    // The same path holds pending tasks and permanent UID-only closure tombstones.
    function accountActive(uid) {
      let consent = /databases/$(database)/documents/users/$(uid)/server/guardianConsent;
      return !exists(/databases/$(database)/documents/accountDeletions/$(uid))
          && (!exists(consent) || get(consent).data.get('status', '') != 'withdrawn');
    }

    function isSignedIn() {
      return request.auth != null && accountActive(request.auth.uid);
    }

    function isNamedUser() {
      return isSignedIn()
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return isNamedUser() && request.auth.uid == uid;
    }

    function hasLivePro() {
      return request.auth.token.pro == true
          && request.auth.token.proUntil is number
          && request.auth.token.proUntil > request.time.toMillis();
    }

    function isProUser() {
      return isNamedUser() && hasLivePro();
    }

    function isProOwner(uid) {
      return isOwner(uid) && hasLivePro();
    }

    function activeGenerationId(uid) {
      return get(
        /databases/$(database)/documents/users/$(uid)/sync_state/current
      ).data.activeGenerationId;
    }

    function isActiveGeneration(uid, generationId) {
      return exists(
        /databases/$(database)/documents/users/$(uid)/sync_state/current
      )
          && activeGenerationId(uid) == generationId;
    }

    function isStagingGeneration(uid, generationId) {
      return exists(
        /databases/$(database)/documents/users/$(uid)/sync_generations/$(generationId)
      )
          && get(
            /databases/$(database)/documents/users/$(uid)/sync_generations/$(generationId)
          ).data.status == 'staging';
    }

    function stageWindowAvailable(uid) {
      let path = /databases/$(database)/documents/users/$(uid)/limits/syncGeneration;
      return !exists(path)
          || get(path).data.lastStagedAt <= request.time - duration.value(5, 'm');
    }

    function stageAuthorized(uid, generationId) {
      let path = /databases/$(database)/documents/users/$(uid)/limits/syncGeneration;
      return getAfter(path).data.lastStagedAt == request.time
          && getAfter(path).data.generationId == generationId
          && stageWindowAvailable(uid);
    }

    function validStageLimit(uid) {
      let id = request.resource.data.generationId;
      let path = /databases/$(database)/documents/users/$(uid)/sync_generations/$(id);
      return request.resource.data.keys().hasAll(['lastStagedAt', 'generationId'])
          && request.resource.data.keys().hasOnly(['lastStagedAt', 'generationId'])
          && id is string && id.size() > 0 && id.size() <= 128
          && !id.matches('.*[/].*')
          && request.resource.data.lastStagedAt == request.time
          && !exists(path)
          && getAfter(path).data.status == 'staging'
          && getAfter(path).data.createdAt == request.time
          && stageWindowAvailable(uid);
    }

    // Update these allowlists in the same change as any synced field change.
    // Payload fields may be absent on tombstones.
    function isValidSyncRowWrite(fields) {
      return request.resource.data.keys().hasAll([
            'updatedAt',
            'originDeviceId',
            'mutationId',
            'schemaVersion',
            'deleted'
          ])
          && request.resource.data.keys().hasOnly(fields)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.originDeviceId is string
          && request.resource.data.originDeviceId.size() > 0
          && request.resource.data.originDeviceId.size() <= 128
          && request.resource.data.mutationId is string
          && request.resource.data.mutationId.size() > 0
          && request.resource.data.mutationId.size() <= 128
          && request.resource.data.schemaVersion == 1
          && request.resource.data.deleted is bool;
    }

    // Payload field checks for synced rows. Every field may be absent (a
    // tombstone carries none) and, when present, must have the type and size
    // the app's mapper writes (lib/core/sync/mapping). `d` is the row, `k` the
    // field. Caps: ids, keys, names and labels 200 characters; ISO dates the
    // exact UTC form Dart's toIso8601String writes; JSON text 200,000
    // characters, except quiz itemsJson and mock answersJson at 500,000
    // because they carry student-typed notes that the app does not limit.
    // Whole numbers are `int` (Dart writes an int); real-valued fields are
    // `number` because the web client writes 2.0 as an integer.
    function validSyncRowId(rowId) {
      return rowId.size() >= 1 && rowId.size() <= 200
          && !rowId.matches('.*[/].*');
    }

    function isSyncIso(v) {
      return v is string && v.size() <= 40
          && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,6})?Z$');
    }

    function syncStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    function syncStrOrNull(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }

    function syncIso(d, k) {
      return !(k in d) || isSyncIso(d[k]);
    }

    function syncIsoOrNull(d, k) {
      return !(k in d) || d[k] == null || isSyncIso(d[k]);
    }

    function syncInt(d, k) {
      return !(k in d) || d[k] is int;
    }

    function syncIntOrNull(d, k) {
      return !(k in d) || d[k] == null || d[k] is int;
    }

    function syncNum(d, k) {
      return !(k in d) || d[k] is number;
    }

    function syncBool(d, k) {
      return !(k in d) || d[k] is bool;
    }

    function validQuizAttemptRow(d) {
      return syncStr(d, 'id', 200) && syncStr(d, 'examId', 200)
          && syncIso(d, 'startedAt') && syncIsoOrNull(d, 'completedAt')
          && syncStr(d, 'origin', 200) && syncStr(d, 'itemsJson', 500000);
    }

    function validAssessmentRow(d) {
      return syncStr(d, 'examId', 200) && syncIso(d, 'completedAt')
          && syncStr(d, 'topicScoresJson', 200000);
    }

    function validFsrsCardRow(d) {
      return syncStr(d, 'questionId', 200) && syncInt(d, 'questionVersion')
          && syncStr(d, 'stage', 200) && syncNum(d, 'stability')
          && syncNum(d, 'difficulty') && syncIso(d, 'due')
          && syncIso(d, 'lastReview') && syncInt(d, 'reps')
          && syncInt(d, 'lapses') && syncNum(d, 'elapsedDays')
          && syncNum(d, 'scheduledDays');
    }

    function validLessonProgressRow(d) {
      return syncStr(d, 'lessonId', 200) && syncIso(d, 'readAt');
    }

    function validLessonBookmarkRow(d) {
      return syncStr(d, 'lessonId', 200) && syncIso(d, 'markedAt')
          && syncIntOrNull(d, 'sortIndex');
    }

    function validQuestionFlagRow(d) {
      return syncStr(d, 'questionId', 200) && syncIso(d, 'flaggedAt')
          && syncIntOrNull(d, 'sortIndex');
    }

    function validMockExamAttemptRow(d) {
      return syncStr(d, 'id', 200) && syncStr(d, 'userId', 200)
          && syncStr(d, 'examId', 200) && syncStr(d, 'blueprintId', 200)
          && syncStr(d, 'blueprintName', 200) && syncInt(d, 'durationMinutes')
          && syncStr(d, 'status', 200) && syncBool(d, 'strictMode')
          && syncStr(d, 'sampledQuestionsJson', 200000)
          && syncInt(d, 'elapsedSeconds')
          && syncInt(d, 'accumulatedPausedSeconds')
          && syncBool(d, 'pausedAtLastFlush')
          && syncStr(d, 'answersJson', 500000)
          && syncStr(d, 'flagsJson', 200000)
          && syncInt(d, 'currentIndex') && syncIntOrNull(d, 'scoreRaw')
          && syncIntOrNull(d, 'scoreTotal')
          && syncStrOrNull(d, 'sectionResultsJson', 200000)
          && syncIntOrNull(d, 'totalTimeSeconds')
          && syncIso(d, 'startedAt') && syncIso(d, 'lastFlushedAt')
          && syncIsoOrNull(d, 'submittedAt')
          && syncIso(d, 'attemptUpdatedAt');
    }

    function validReviewLogRow(d) {
      return syncStr(d, 'id', 200) && syncStr(d, 'questionId', 200)
          && syncInt(d, 'rating') && syncInt(d, 'state')
          && syncIso(d, 'due') && syncNum(d, 'stability')
          && syncNum(d, 'difficulty') && syncNum(d, 'elapsedDays')
          && syncNum(d, 'lastElapsedDays') && syncNum(d, 'scheduledDays')
          && syncIso(d, 'review') && syncInt(d, 'durationMs')
          && syncBool(d, 'isCorrect') && syncInt(d, 'heuristicVersion');
    }

    // Two row shapes share this collection: the custom track's name
    // (kind custom_track, has name) and a hidden topic (kind scope, has topicId).
    function validTrackScopeRow(d) {
      return syncStr(d, 'examId', 200)
          && (!('kind' in d) || d.kind == 'custom_track' || d.kind == 'scope')
          && syncStr(d, 'name', 200) && syncStr(d, 'topicId', 200)
          && !('kind' in d && d.kind == 'custom_track' && 'topicId' in d)
          && !('kind' in d && d.kind == 'scope' && 'name' in d)
          && !('name' in d && 'topicId' in d);
    }

    function validCustomBlueprintRow(d) {
      return syncStr(d, 'examId', 200) && syncInt(d, 'totalQuestions')
          && syncInt(d, 'totalMinutes') && syncStr(d, 'sectionsJson', 200000)
          && syncBool(d, 'sectionsTimedSeparately')
          && syncIso(d, 'blueprintUpdatedAt');
    }

    function generationNotDeleting(uid, generationId) {
      let path = /databases/$(database)/documents/users/$(uid)/sync_generations/$(generationId);
      return !exists(path) || get(path).data.status != 'deleting';
    }

    function canReadSyncRow(uid, generationId) {
      return isProOwner(uid) && generationNotDeleting(uid, generationId);
    }

    function canWriteSyncRow(uid, generationId, fields) {
      return isProOwner(uid)
          && generationNotDeleting(uid, generationId)
          && (
            isActiveGeneration(uid, generationId)
            || isStagingGeneration(uid, generationId)
          )
          && isValidSyncRowWrite(fields);
    }

    // Optional user-root fields: absent, null, or the stated type and size.
    function validUserRootFields() {
      let d = request.resource.data;
      return (!('displayName' in d) || d.displayName == null
              || (d.displayName is string && d.displayName.size() <= 128))
          && (!('photoUrl' in d) || d.photoUrl == null
              || (d.photoUrl is string && d.photoUrl.size() <= 2048))
          && (!('lastSeenAt' in d) || d.lastSeenAt == null
              || d.lastSeenAt is timestamp)
          && (!('preferences' in d) || d.preferences == null
              || (d.preferences is map && d.preferences.size() <= 200))
          && (!('schemaVersion' in d) || d.schemaVersion == null
              || d.schemaVersion is int);
    }

    function validGenerationPreferences() {
      return request.resource.data.preferences is map
          && request.resource.data.preferences.size() <= 200;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'photoUrl',
            'lastSeenAt',
            'preferences',
            'schemaVersion'
          ])
          && validUserRootFields();
      allow delete: if false;

      match /server/{document=**} {
        allow read, write: if false;
      }

      match /passes/{transactionId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      match /betaFeedback/{feedbackId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /betaReward/{document} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /grants/{grantId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      match /sync_state/{stateId} {
        allow read: if stateId == 'current' && isProOwner(uid);
        allow write: if false;
      }

      match /limits/{key} {
        allow create, update: if key == 'syncGeneration'
            && isProOwner(uid) && validStageLimit(uid);
        allow read, delete: if false;
      }

      match /sync_generations/{generationId} {
        allow read: if isProOwner(uid) && generationNotDeleting(uid, generationId);

        allow create: if isProOwner(uid)
            && stageAuthorized(uid, generationId)
            && request.resource.data.keys().hasAll([
              'status',
              'schemaVersion',
              'createdAt',
              'createdByDeviceId',
              'preferences'
            ])
            && request.resource.data.keys().hasOnly([
              'status',
              'schemaVersion',
              'createdAt',
              'createdByDeviceId',
              'preferences'
            ])
            && request.resource.data.status == 'staging'
            && request.resource.data.schemaVersion == 1
            && request.resource.data.createdAt == request.time
            && request.resource.data.createdByDeviceId is string
            && request.resource.data.createdByDeviceId.size() > 0
            && request.resource.data.createdByDeviceId.size() <= 128
            && validGenerationPreferences();

        allow update: if isProOwner(uid)
            && (
              resource.data.status == 'active'
              || resource.data.status == 'staging'
            )
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['preferences'])
            && validGenerationPreferences();

        allow delete: if false;

        match /quiz_attempts/{rowId} {
          allow read: if canReadSyncRow(uid, generationId);
          allow create, update: if canWriteSyncRow(uid, generationId, [
            'id', 'examId', 'startedAt', 'completedAt',
            'origin', 'itemsJson', 'updatedAt', 'originDeviceId',
            'mutationId', 'schemaVersion', 'deleted'
          ])
            && validSyncRowId(rowId)
            && validQuizAttemptRow(request.resource.data);
          allow delete: if false;
        }

        match /assessments/{rowId} {
          allow read: if canReadSyncRow(uid, generationId);
          allow create, update: if canWriteSyncRow(uid, generationId, [
            'examId', 'completedAt', 'topicScoresJson', 'updatedAt',
            'originDeviceId', 'mutationId', 'schemaVersion', 'deleted'
          ])
            && validSyncRowId(rowId)
            && validAssessmentRow(request.resource.data);
          allow delete: if false;
        }

        match /fsrs_cards/{rowId} {
          allow read: if canReadSyncRow(uid, generationId);
          allow create, update: if canWriteSyncRow(uid, generationId, [
            'questionId', 'questionVersion', 'stage', 'stability',
            'difficulty', 'due', 'lastReview', 'reps',
            'lapses', 'elapsedDays', 'scheduledDays', 'updatedAt',
            'originDeviceId', 'mutationId', 'schemaVersion', 'deleted'
          ])
            && validSyncRowId(rowId)
            && validFsrsCardRow(request.resource.data);
          allow delete: if false;
        }

        match /lesson_progress/{rowId} {
          allow read: if canReadSyncRow(uid, generationId);
          allow create, update: if canWriteSyncRow(uid, generationId, [
            'lessonId', 'readAt', 'updatedAt', 'originDeviceId',
            'mutationId', 'schemaVersion', 'deleted'
          ])
            && validSyncRowId(rowId)
            && validLessonProgressRow(request.resource.data);
          allow delete: if false;
        }

        match /lesson_bookmarks/{rowId} {
          allow read: if canReadSyncRow(uid, generationId);
          allow create, update: if canWriteSyncRow(uid, generationId, [
            'lessonId', 'markedAt', 'sortIndex', 'updatedAt',
            'originDeviceId', 'mutationId', 'schemaVersion', 'deleted'
          ])
            && validSyncRowId(rowId)
            && validLessonBookmarkRow(request.resource.data);
          allow delete: if false;
        }

        match /question_flags/{rowId} {
          allow read: if canReadSyncRow(uid, generationId);
          allow create, update: if canWriteSyncRow(uid, generationId, [
            'questionId', 'flaggedAt', 'sortIndex', 'updatedAt',
            'originDeviceId', 'mutationId', 'schemaVersion', 'deleted'
          ])
            && validSyncRowId(rowId)
            && validQuestionFlagRow(request.resource.data);
          allow delete: if false;
        }

        match /mock_exam_attempts/{rowId} {
          allow read: if canReadSyncRow(uid, generationId);
          allow create, update: if canWriteSyncRow(uid, generationId, [
            'id', 'userId', 'examId', 'blueprintId',
            'blueprintName', 'durationMinutes', 'status', 'strictMode',
            'sampledQuestionsJson', 'elapsedSeconds', 'accumulatedPausedSeconds', 'pausedAtLastFlush',
            'answersJson', 'flagsJson', 'currentIndex', 'scoreRaw',
            'scoreTotal', 'sectionResultsJson', 'totalTimeSeconds', 'startedAt',
            'lastFlushedAt', 'submittedAt', 'attemptUpdatedAt', 'updatedAt',
            'originDeviceId', 'mutationId', 'schemaVersion', 'deleted'
          ])
            && validSyncRowId(rowId)
            && validMockExamAttemptRow(request.resource.data);
          allow delete: if false;
        }

        match /review_logs/{rowId} {
          allow read: if canReadSyncRow(uid, generationId);
          allow create, update: if canWriteSyncRow(uid, generationId, [
            'id', 'questionId', 'rating', 'state',
            'due', 'stability', 'difficulty', 'elapsedDays',
            'lastElapsedDays', 'scheduledDays', 'review', 'durationMs',
            'isCorrect', 'heuristicVersion', 'updatedAt', 'originDeviceId',
            'mutationId', 'schemaVersion', 'deleted'
          ])
            && validSyncRowId(rowId)
            && validReviewLogRow(request.resource.data);
          allow delete: if false;
        }

        match /track_scope/{rowId} {
          allow read: if canReadSyncRow(uid, generationId);
          allow create, update: if canWriteSyncRow(uid, generationId, [
            'kind', 'examId', 'name', 'topicId',
            'updatedAt', 'originDeviceId', 'mutationId', 'schemaVersion',
            'deleted'
          ])
            && validSyncRowId(rowId)
            && validTrackScopeRow(request.resource.data);
          allow delete: if false;
        }

        match /custom_blueprints/{rowId} {
          allow read: if canReadSyncRow(uid, generationId);
          allow create, update: if canWriteSyncRow(uid, generationId, [
            'examId', 'totalQuestions', 'totalMinutes', 'sectionsJson',
            'sectionsTimedSeparately', 'blueprintUpdatedAt', 'updatedAt', 'originDeviceId',
            'mutationId', 'schemaVersion', 'deleted'
          ])
            && validSyncRowId(rowId)
            && validCustomBlueprintRow(request.resource.data);
          allow delete: if false;
        }
      }

      // No server code writes this path and no client reads it. Closed
      // until a feature needs it (L1 review, 30 October 2026).
      match /proDossiers/{dossierId} {
        allow read, write: if false;
      }
    }

    match /examTracks/{trackId}/proContent/{contentId} {
      // Tiered server content is not available yet.
      allow read: if false;
      allow write: if false;
    }

    // Content is served only by the getContent callable (Admin SDK). Pro-only fields
    // live in contentPro. No client may read or write either, whatever its claims say.
    match /content/{kind}/items/{itemId} {
      allow read, write: if false;
    }

    match /contentPro/{itemId} {
      allow read, write: if false;
    }

    // Daily delivered-content counters, written and read by the getContent callable only.
    match /contentCeiling/{document=**} {
      allow read, write: if false;
    }

    // Beta applications are written by the Cloudflare Worker with server
    // credentials. Client claims, including Pro, never authorize access.
    match /betaApplications/{document=**} {
      allow read, write: if false;
    }

    // Guardian consent link records and send counters: server only, keyed by hash.
    match /guardianTokens/{hash} {
      allow read, write: if false;
    }

    // Minimum guardian response evidence survives deletion of the user tree.
    match /guardianConsentEvidence/{document=**} {
      allow read, write: if false;
    }

    match /guardianLimits/{hash} {
      allow read, write: if false;
    }

    // Deletions that have started and not finished: server only, retried by the daily job.
    match /accountDeletions/{uid} {
      allow read, write: if false;
    }

    // Where a scheduled job stopped: server only.
    match /jobState/{document=**} {
      allow read, write: if false;
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    match /publicIds/{publicId} {
      allow read, write: if false;
    }

    match /retiredPublicIds/{publicId} {
      allow read, write: if false;
    }

    // Hosted Wrapped cards. The landing-page Cloud Function reads these via
    // the Admin SDK (bypassing rules), so client reads stay closed. Only a named
    // (non-anonymous) owner may create their own card, which must carry an
    // `purgeAt` within 90 days (the TTL field). The owner may only flip
    // `revoked` to true.
    match /wrapped_shares/{shareId} {
      allow read: if false;
      allow create: if isSignedIn()
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.resource.data.ownerUid == request.auth.uid
          && shareId.matches('^[0-9a-f]{32}$')
          && request.resource.data.storagePath ==
              'wrapped/' + request.auth.uid + '/' + shareId + '.png'
          && request.resource.data.revoked == false
          && request.resource.data.keys().hasOnly([
            'ownerUid', 'storagePath', 'archetypeId', 'createdAt', 'revoked', 'purgeAt'
          ])
          // The TTL field: between now and 90 days from now.
          && request.resource.data.purgeAt is timestamp
          && request.resource.data.purgeAt > request.time
          && request.resource.data.purgeAt <= request.time + duration.value(90, 'd')
          && (!('archetypeId' in request.resource.data)
              || (request.resource.data.archetypeId is string
                  && request.resource.data.archetypeId.size() <= 64))
          && (!('createdAt' in request.resource.data)
              || request.resource.data.createdAt is timestamp);
      allow update: if isSignedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['revoked'])
          && request.resource.data.revoked == true;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
