# Copied to build/web/_headers by deploy.sh. M4 security pass (Nov 22, 2026): enforced nosniff, referrer,
# permissions and frame-ancestors headers; a report-only CSP for a week before it is enforced (reports go to
# the Worker's /__/csp-report and Workers Logs).
# Matches what Firebase Hosting sent on Nov 14, 2026:
# root files revalidate every time (Cloudflare's default, the same as firebase.json's max-age=0 rules),
# files in folders and the root images and wasm are cached for an hour (Firebase's default).
/*
  Strict-Transport-Security: max-age=31556926
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'self'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-wLXA+w+9L9bTF96SO3KPEs30qNhuiOJJxLtqMR1MJFc=' https://www.gstatic.com https://www.google.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://asia-southeast1-pantas-prod.cloudfunctions.net https://www.google.com https://www.gstatic.com wss://*.firebaseio.com https://*.firebaseio.com; frame-src 'self' https://www.google.com https://accounts.google.com https://pantas-prod.firebaseapp.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob: data:; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /__/csp-report
/assets/*
  Cache-Control: max-age=3600
/canvaskit/*
  Cache-Control: max-age=3600
/icons/*
  Cache-Control: max-age=3600
/favicon.png
  Cache-Control: max-age=3600
/og-image.png
  Cache-Control: max-age=3600
/sqlite3.wasm
  Cache-Control: max-age=3600
