// Worker that serves the prod web app. Deploy only with tool/cloudflare-app/deploy.sh prod.
{
  "name": "pantas-app",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // Attached on Nov 14, 2026 (security fixes step 5). Rollback: docs/deploy-prod.md, section 14.
  "routes": [{"pattern": "app.pantas.study", "custom_domain": true}],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Serve /index.html as is: a redirect to / would break the service worker's cache.
    "html_handling": "none",
    "run_worker_first": ["/__/*"]
  },
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "vars": {"FIREBASE_ORIGIN": "https://pantas-prod.firebaseapp.com"}
}
