#!/usr/bin/env bash
#
# Switch the running dev build between Free and Pro without touching the app.
#
#   tools/pro           what it is set to now
#   tools/pro on        Pro
#   tools/pro off       Free
#   tools/pro toggle    the other one
#   tools/pro clear     no override, the real store entitlement decides
#
# It talks to the Dart VM service over the port `flutter run` already forwards
# through adb, so the app keeps running and the screen changes as you watch.
# The setting is stored, so a hot restart keeps it.
#
# Needs the emulator up and one `flutter run` alive. Nothing else.

set -euo pipefail

cache="${TMPDIR:-/tmp}/pantas-vm-service"

die() { echo "pro: $*" >&2; exit 1; }

# The live service announces itself in logcat; the adb forward table can
# still hold the entry of a run that has been killed, so logcat is the
# authority and the forward table is looked up from it rather than trusted.
discover() {
  local line device_port token host_port
  line="$(adb logcat -d 2>/dev/null \
    | grep -o 'Dart VM service is listening on http://127.0.0.1:[0-9]*/[^/]*/' \
    | tail -1)" || true
  [ -n "$line" ] || die "no Dart VM service in logcat. Is 'flutter run' alive?"

  device_port="$(echo "$line" | sed -E 's#.*127\.0\.0\.1:([0-9]+)/.*#\1#')"
  # Trailing slash trimmed: the printed URI ends in one and a doubled slash
  # is a 404 rather than an RPC.
  token="$(echo "$line" | sed -E 's#.*127\.0\.0\.1:[0-9]+/##; s#/$##')"

  host_port="$(adb forward --list 2>/dev/null \
    | awk -v d="tcp:${device_port}" '$3 == d {print $2}' \
    | cut -d: -f2 | head -1)"
  if [ -z "$host_port" ]; then
    host_port="$(adb forward tcp:0 "tcp:${device_port}" 2>/dev/null)"
  fi
  [ -n "$host_port" ] || die "could not forward the service port."

  echo "http://127.0.0.1:${host_port}/${token}"
}

call() {
  curl -s -m 5 "$1"
}

base="${VM_SERVICE_URI:-}"
# Strip any trailing slash provided by the user
base="$(echo "$base" | sed -E 's#/$##')"

if [ -n "$base" ]; then
  call "${base}/getVersion" | grep -q '"result"' || die "The provided VM_SERVICE_URI ($base) is unreachable. Unset it to auto-discover, or provide a correct one."
elif [ -f "$cache" ]; then
  base="$(cat "$cache")"
  # A cached URI goes stale every time `flutter run` restarts.
  call "${base}/getVersion" | grep -q '"result"' || base=""
fi

if [ -z "$base" ]; then
  base="$(discover)"
  echo "$base" > "$cache"
fi

isolate="$(call "${base}/getVM" | python3 -c '
import json, sys
try:
    isolates = json.load(sys.stdin)["result"]["isolates"]
except Exception:
    sys.exit(0)
# The main isolate is the one the app runs in.
for i in isolates:
    if i.get("name", "").endswith("main"):
        print(i["id"])
        break
else:
    if isolates:
        print(isolates[0]["id"])
' || true)"
[ -n "$isolate" ] || die "no isolate. Is the app running?"

case "${1:-report}" in
  on|pro|true)    value=true ;;
  off|free|false) value=false ;;
  toggle)         value=toggle ;;
  clear|none)     value=clear ;;
  report|"")      value=report ;;
  *)              die "unknown argument '${1}'. Use on, off, toggle or clear." ;;
esac

response="$(call "${base}/ext.pantas.pro?isolateId=${isolate}&value=${value}")"

case "$response" in
  *'"pro":true'*)  echo "Pro" ;;
  *'"pro":false'*) echo "Free" ;;
  *'"pro":null'*)  echo "no override, the store decides" ;;
  *) die "unexpected reply: $response" ;;
esac
