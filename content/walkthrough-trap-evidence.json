        {
          "questionId": "q-arithmetic-number-sense-real-imaginary-numbers-0014",
          "wrongChoice": "$3$",
          "mistakeNote": "Drops i / treats negative square roots as positive real roots in sqrt(-36)*sqrt(-4)/sqrt(-16), getting 3 instead of 3i."
        }
