  "lessons": {
    "lesson-algebra-age-word-problems": {
      "change-both-ages": [
        {
          "questionId": "q-algebra-word-problems-0007",
          "wrongChoice": "$18\\text{ years old}$",
          "mistakeNote": "Omits the mother's six-year increase, giving 4a = 3(a + 6) instead of 4a + 6 = 3(a + 6)."
        }
      ],
      "wrong-person-or-time": [
        {
          "questionId": "q-algebra-word-problems-0001",
          "wrongChoice": "$14\\text{ years old}$",
          "mistakeNote": "Reports Ben's age (m + 4 = 14) instead of Maya's age (m = 10)."
        },
        {
          "questionId": "q-algebra-word-problems-0011",
          "wrongChoice": "$12\\text{ years old}$",
          "mistakeNote": "Reports Carlo's age four years ago instead of his current age."
        }
      ]
    },
    "lesson-algebra-motion-meeting-and-separation": {
      "speed-over-distance": [
        {
          "questionId": "q-algebra-word-problems-0002",
          "wrongChoice": "$0.67\\text{ hours}$",
          "mistakeNote": "Divides speed by distance (30 / 45) instead of distance by speed (45 / 30)."
        }
      ],
      "subtract-instead-of-add": [
        {
          "questionId": "q-algebra-word-problems-0014",
          "wrongChoice": "$18\\text{ hours}$",
          "mistakeNote": "Subtracts 35 - 25 = 10 km/h (chase rate) instead of adding 25 + 35 = 60 km/h for opposite directions."
        }
      ],
      "average-speeds-mistake": [
        {
          "questionId": "q-algebra-word-problems-0014",
          "wrongChoice": "$6\\text{ hours}$",
          "mistakeNote": "Averages the two speeds (30 km/h) before dividing 180 km instead of adding both speeds (60 km/h)."
        }
      ]
    },
    "lesson-algebra-motion-chase-problems": {
      "add-speeds-in-chase": [
        {
          "questionId": "q-algebra-word-problems-0008",
          "wrongChoice": "$0.4\\text{ hour}$",
          "mistakeNote": "Adds 60 + 40 = 100 km/h instead of subtracting 60 - 40 = 20 km/h for a same-direction chase."
        }
      ],
      "use-only-chaser-speed": [
        {
          "questionId": "q-algebra-word-problems-0008",
          "wrongChoice": "$\\dfrac{2}{3}\\text{ hour}$",
          "mistakeNote": "Divides the 40 km head start by the van's 60 km/h speed alone, ignoring that the jeepney keeps moving."
        }
      ],
      "head-start-clock": [
        {
          "questionId": "q-algebra-word-problems-0008",
          "wrongChoice": "$3\\text{ hours}$",
          "mistakeNote": "Includes the jeepney's 1-hour head start (2 + 1 = 3) when the question asks for hours after the van starts."
        }
      ]
    },
    "lesson-algebra-work-rate-problems": {
      "average-work-times": [
        {
          "questionId": "q-algebra-word-problems-0003",
          "wrongChoice": "$4.5\\text{ hours}$",
          "mistakeNote": "Averages the solo times (6 + 3)/2 = 4.5 instead of adding work rates 1/6 + 1/3."
        }
      ],
      "rate-not-time": [
        {
          "questionId": "q-algebra-word-problems-0009",
          "wrongChoice": "$\\dfrac{5}{24}\\text{ hour}$",
          "mistakeNote": "Reports Bea's hourly work rate (5/24) instead of taking its reciprocal (24/5 = 4.8 hours)."
        }
      ],
      "subtract-solo-times": [
        {
          "questionId": "q-algebra-word-problems-0009",
          "wrongChoice": "$5\\text{ hours}$",
          "mistakeNote": "Subtracts solo times directly (8 - 3 = 5) instead of subtracting rates (1/3 - 1/8)."
        }
      ]
    },
