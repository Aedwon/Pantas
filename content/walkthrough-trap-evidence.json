        {
          "questionId": "q-arithmetic-number-sense-real-imaginary-numbers-0016",
          "wrongChoice": "$-4i$",
          "mistakeNote": "Gives the entire imaginary term -4i instead of the real coefficient b = -4 in a + bi."
