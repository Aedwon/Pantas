    "lesson-arithmetic-number-sense-operation-priority-and-left-to-right": {
      "power-not-product": [
        {
          "questionId": "q-arithmetic-number-sense-order-of-operations-0016",
          "wrongChoice": "$13$",
          "mistakeNote": "Evaluates 2^3 as 2 * 3 = 6 instead of 2 * 2 * 2 = 8, giving 7 + 6 = 13."
        }
      ],
      "multiply-before-divide": [
        {
          "questionId": "q-arithmetic-number-sense-order-of-operations-0001",
          "wrongChoice": "$3$",
          "mistakeNote": "Multiplies 3 * 2 = 6 before dividing 18 / 3 in 18 / 3 * 2, breaking left-to-right order."
        }
      ],
      "add-before-subtract": [
        {
          "questionId": "q-arithmetic-number-sense-order-of-operations-0002",
          "wrongChoice": "$6$",
          "mistakeNote": "Adds 5 + 4 = 9 before subtracting from 15 in 15 - 5 + 4, breaking left-to-right order."
        }
      ]
    },
    "lesson-arithmetic-number-sense-grouping-and-fraction-bars": {
      "multiply-into-power": [
        {
          "questionId": "q-arithmetic-number-sense-order-of-operations-0004",
          "wrongChoice": "$400$",
          "mistakeNote": "Multiplies 4 * 5 = 20 before squaring in 4 * (8 - 3)^2, giving 20^2 = 400 instead of 4 * 25 = 100."
        }
      ],
      "fraction-bar-not-grouped": [
        {
          "questionId": "q-arithmetic-number-sense-order-of-operations-0018",
          "wrongChoice": "$A=B$",
          "mistakeNote": "Treats 48 / (6 + 2) as 48 / 6 + 2, ignoring the grouping effect of the fraction bar."
        }
      ],
      "subtract-inside-denominator": [
        {
          "questionId": "q-arithmetic-number-sense-order-of-operations-0009",
          "wrongChoice": "$2$",
          "mistakeNote": "Subtracts 10 - 3 = 7 before multiplying by 2 in the denominator of (4^2 + 6*2)/(10 - 3*2), giving 28/14 = 2."
        }
      ]
    },
